{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "pages/**/*.ts",
    "tests/tic-tac-toe/**/*.ts",
    "Fixtures/constants.ts",
    "playwright.config.ts"
  ]
}
